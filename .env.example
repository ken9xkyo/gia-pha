# ==== Tên miền & HTTPS ====
# Tên miền thật (VD: giapha.ho-nguyen.vn) → Caddy tự cấp chứng chỉ Let's Encrypt.
# Để "localhost" khi chạy thử trên máy (chứng chỉ nội bộ, trình duyệt sẽ cảnh báo).
DOMAIN=localhost
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# ==== Bí mật (bắt buộc đổi; `make init` sẽ tự sinh) ====
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_USER=giapha
POSTGRES_DB=giapha

# ==== Dòng họ & admin đầu tiên (chỉ dùng khi hệ thống chưa có admin nào) ====
CLAN_NAME=Họ Nguyễn
INITIAL_ADMIN_EMAIL=admin@example.com
# Tối thiểu 10 ký tự, gồm 3 trong 4 loại: thường, hoa, số, ký tự đặc biệt
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Quản trị viên

# ==== Khác ====
# Cookie chỉ gửi qua HTTPS (để true khi chạy sau Caddy)
COOKIE_SECURE=true
# Giới hạn gọi API công khai mỗi phút / IP (chống cào dữ liệu)
PUBLIC_RATE_LIMIT_PER_MIN=240
# Sao lưu hằng ngày lúc mấy giờ (giờ Việt Nam) và giữ bao nhiêu bản
BACKUP_HOUR=2
BACKUP_KEEP=30
